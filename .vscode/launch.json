{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "yada",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "api.main:app",
        "--reload",
        "--reload-dir",
        "api",
        "--reload-dir",
        "apps",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "TOKENIZERS_PARALLELISM": "false",
        "USER_AGENT": "yada/0.1 (contact@example.com)"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "/Users/troy/.pyenv/versions/yada-3.14.7/bin/python"
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "mcp_server.server",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "/Users/troy/.pyenv/versions/yada-3.14.7/bin/python",
      "name": "yada MCP server (http)",
      "env": {
        "TOKENIZERS_PARALLELISM": "false",
        "YADA_MCP_TRANSPORT": "streamable-http",
        "YADA_MCP_HOST": "127.0.0.1",
        "YADA_MCP_PORT": "8081"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "mcp_server.server",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "/Users/troy/.pyenv/versions/yada-3.14.7/bin/python",
      "name": "yada MCP server (http, DEBUG)",
      "env": {
        "TOKENIZERS_PARALLELISM": "false",
        "YADA_MCP_TRANSPORT": "streamable-http",
        "YADA_MCP_HOST": "127.0.0.1",
        "YADA_MCP_PORT": "8081",
        "YADA_LOG_LEVEL": "DEBUG"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "mcp_server.server",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "/Users/troy/.pyenv/versions/yada-3.14.7/bin/python",
      "name": "yada MCP server (stdio)",
      "env": {
        "TOKENIZERS_PARALLELISM": "false",
        "YADA_MCP_TRANSPORT": "stdio"
      }
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "python": "/Users/troy/.pyenv/versions/yada-3.14.7/bin/python"
    },
    {
      "name": "FRED Loader",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/clients/bin/fred.py",
      "args": [
        "--db-path",
        "${workspaceFolder}/.db"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "python": "/Users/troy/.pyenv/versions/yada-3.14.7/bin/python"
    },
    {
