# navi declares the analysis and plot stack it imports (numpy, pandas, scipy,
# statsmodels, matplotlib, matplotlib-label-lines, cycler, tabulate, shortuuid,
# httpx, pydantic, python-dotenv, curl_cffi), so they are not repeated here.
# Lines below that name one of those carry a deliberate constraint.
-e ../navi
jupyterlab
aiofiles
jupyter
python-lsp-server[all]   # language server behind jupyter-lsp (successor of python-language-server)
pandas<3
fastapi
uvicorn[standard]
langchain[mcp]>=1.4.0   # [mcp] extra -> fastmcp; replaces langchain-mcp-adapters
langchain-text-splitters
langgraph
langgraph-checkpoint-sqlite
langchain-openai
langchain-anthropic
langchain_community
langchain-tavily
langsmith
langchain_chroma
chromadb
SQLAlchemy
ipython
ipykernel
alembic
backtrader
beautifulsoup4
coloredlogs
debugpy
gitdb
GitPython
markdown-it-py
mcp>=2,<3
pip-tools
psycopg2
financedatabase
lxml
pytest
